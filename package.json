{
  "name": "lazos-pergamino-backend",
  "version": "1.0.0",
  "description": "Backend de pergaminos digitales por sala para funerarias, con QR fijos y libro de condolencias",
  "main": "server.js",
  "directories": {},
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check:db": "node check-database.js",
    "clear:db": "node clear-database.js",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d mongo",
    "db:logs": "docker compose logs -f mongo",
    "db:ui": "docker compose --profile tools up -d mongo-express",
    "db:shell": "docker compose exec mongo mongosh -u root -p rootpass --authenticationDatabase admin lazos_pergamino",
    "dev:full": "npm run db:up && npm run dev",
    "seed:demo": "node seed-demo.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.830.0",
    "@aws-sdk/s3-request-presigner": "^3.832.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^6.11.2",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "multer": "^2.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "eslint": "^9.29.0",
    "nodemon": "^3.1.10"
  }
}
