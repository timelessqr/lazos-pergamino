# ===================================
# ENTORNO
# ===================================
NODE_ENV=development
PORT=3000

# ===================================
# BASE DE DATOS
# ===================================
# Mongo dockerizado (docker compose up -d mongo)
MONGODB_URI=mongodb://lazos:lazospass@127.0.0.1:27018/lazos_pergamino?authSource=lazos_pergamino

# Config del contenedor de Mongo (usado por docker-compose.yml)
MONGO_PORT=27018
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpass
MONGO_DB=lazos_pergamino
MONGO_UI_PORT=8081
MONGO_UI_USER=admin
MONGO_UI_PASSWORD=admin

# ===================================
# SEGURIDAD / AUTENTICACION
# ===================================
# La autenticacion la maneja core-qr: el emite el token en su login.
# Este backend NO emite tokens ni guarda contrasenas, solo verifica la firma.
# JWT_SECRET DEBE ser identico al de core-qr o los tokens no validaran.
JWT_SECRET=mi_super_secreto_jwt_para_desarrollo_12345
JWT_EXPIRES_IN=7d
# _id de usuarios de core-qr que son superadmin aqui, separados por coma.
# Se aseguran al arrancar; quitar uno de la lista NO le quita el acceso.
SUPERADMIN_CORE_USER_IDS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# URLs
# ===================================
FRONTEND_URL=http://localhost:5173
# URL base que se codifica en los QR de sala: {QR_BASE_URL}/{code}
QR_BASE_URL=http://localhost:5173/pergamino

# ===================================
# REGLAS DE NEGOCIO
# ===================================
# Salas fijas que se crean automaticamente al registrar una funeraria
SALAS_POR_FUNERARIA=4

# ===================================
# QR
# ===================================
QR_IMAGE_SIZE=512
QR_IMAGE_QUALITY=0.92

# ===================================
# ARCHIVOS
# ===================================
MAX_PHOTO_SIZE_MB=5
MAX_FILE_SIZE_MB=100
SALA_MAX_PHOTOS=50
SALA_MAX_STORAGE_MB=500

# ===================================
# ALMACENAMIENTO (local | r2)
# ===================================
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Cloudflare R2 (solo si STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
